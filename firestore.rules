rules_version = '2';
// 拉麺帖の共有の守り。Firebase のコンソール →「Firestore Database」→「ルール」にこのまま貼る。
// - グループの合言葉（= グループの名前）を知っている、ログインした人だけがグループにたどり着ける
// - 記録を読めるのはグループのメンバーだけ
// - 直したり消したりできるのは自分の記録だけ
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(gid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }
    // 名前（names）は自分の分だけ変えられる
    function onlyMyName() {
      return !('names' in request.resource.data.diff(resource.data).affectedKeys()) ||
        request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /groups/{gid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && gid.size() >= 10 &&
        request.resource.data.owner == request.auth.uid &&
        request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && onlyMyName() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']) && (
          // 入る：自分だけを足す
          (!(request.auth.uid in resource.data.members) &&
            request.resource.data.members.hasAll(resource.data.members) &&
            request.resource.data.members.size() == resource.data.members.size() + 1 &&
            request.auth.uid in request.resource.data.members) ||
          // 抜ける：自分だけを外す
          (request.auth.uid in resource.data.members &&
            resource.data.members.hasAll(request.resource.data.members) &&
            request.resource.data.members.size() == resource.data.members.size() - 1 &&
            !(request.auth.uid in request.resource.data.members)) ||
          // メンバーのまま名前だけ変える
          (request.auth.uid in resource.data.members &&
            request.resource.data.members == resource.data.members)
        );

      match /shops/{shopId} {
        allow read, create, update: if isMember(gid);
      }

      match /visits/{visitId} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.by == request.auth.uid;
        allow update: if isMember(gid) && resource.data.by == request.auth.uid &&
          request.resource.data.by == request.auth.uid;
        allow delete: if isMember(gid) && resource.data.by == request.auth.uid;
      }
    }
  }
}
